<!doctype html><html><head><meta charset="utf-8"><title>Java Migration Analysis</title><style>body{font-family:Arial,sans-serif;max-width:1100px;margin:40px auto;padding:0 20px;color:#222}header{background:#1f4e78;color:white;padding:24px;border-radius:10px}.cards{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.card{padding:15px;border:1px solid #ddd;border-radius:8px;min-width:120px}.Critical,.High{border-left:7px solid #c62828}.Medium{border-left:7px solid #ef6c00}.Low{border-left:7px solid #2e7d32}.finding{padding:16px;margin:12px 0;background:#fafafa;border-radius:8px}code{white-space:pre-wrap}table{border-collapse:collapse;width:100%}td,th{padding:8px;border-bottom:1px solid #ddd;text-align:left}</style></head><body><header><h1>Java 8 to Java 25 Migration Analysis</h1><p>{{ target }}</p><strong>Risk score: {{ risk_score }}/100</strong></header><div class="cards">{% for name,count in summary.items() %}<div class="card"><b>{{ name }}</b><br>{{ count }}</div>{% endfor %}</div><h2>Tool execution</h2><table><tr><th>Tool</th><th>Status</th><th>Detail</th></tr>{% for t in tools %}<tr><td>{{ t.name }}</td><td>{{ t.status }}</td><td>{{ t.detail }}</td></tr>{% endfor %}</table><h2>Findings</h2>{% for f in findings %}<section class="finding {{ f.severity }}"><h3>{{ f.severity }} · {{ f.rule_id }} · {{ f.title }}</h3><p><b>Location:</b> {{ f.file or 'project' }}{% if f.line %}:{{ f.line }}{% endif %}</p><p><b>Evidence:</b> <code>{{ f.evidence or 'See tool output' }}</code></p><p>{{ f.explanation }}</p><p><b>Recommendation:</b> {{ f.recommendation }}</p></section>{% endfor %}<h2>Migration roadmap</h2><ol><li>Establish a clean Java 8 build and test baseline.</li><li>Upgrade Maven plugins and dependencies.</li><li>Remove deprecated/internal APIs and Java EE assumptions.</li><li>Validate on an intermediate LTS JDK.</li><li>Target Java 25 and run complete technical and human review.</li></ol></body></html>